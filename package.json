{
  "name": "profemacon-net-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "node --test tests/auth-crypto.test.ts tests/student-import.test.ts tests/student-portfolio.test.mjs tests/activation-delivery.test.ts tests/account-activation-admin.test.ts tests/activity-grading.test.ts tests/activity-authoring.test.ts tests/private-activity-files.test.mjs tests/student-activity.test.mjs tests/activity-authoring-pipeline.test.mjs tests/activity-assignment.test.ts tests/activity-assignment-pipeline.test.mjs tests/teacher-group-results.test.mjs tests/teacher-group-activity-results.test.mjs tests/teacher-group-student-results.test.mjs tests/teacher-group-student-attempts.test.mjs",
    "test:student-activity": "node --test tests/student-activity.test.mjs",
    "test:activity-migration:local": "node scripts/verify-activity-security-local.mjs",
    "activity:validate": "node scripts/activity-authoring.mjs validate",
    "activity:publish:local": "node scripts/activity-authoring.mjs publish:local",
    "activity:assign:validate": "node scripts/activity-assignment.mjs validate",
    "activity:assign:local": "node scripts/activity-assignment.mjs assign:local",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply profemacon-beta-local --local",
    "db:seed:local": "wrangler d1 execute profemacon-beta-local --local --file=seed/001-datos-ficticios.sql",
    "db:seed:variables-pilot:local": "wrangler d1 execute profemacon-beta-local --local --file=seed/actividades/programacion-i/unidad-1/variables-java-01.public.sql",
    "students:preview": "node scripts/preview-student-portfolio.mjs",
    "students:verify-api": "node scripts/verify-student-import-api.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "mermaid": "^11.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.24.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "wrangler": "^4.112.0"
  }
}
